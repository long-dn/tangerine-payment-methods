<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_bank_kanban_views" model="ir.ui.view">
        <field name="name">res.bank.kanban.views</field>
        <field name="model">res.bank</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card" class="flex-row align-items-center">
                        <aside class="o_bank_logo">
                            <field t-if="record.logo_url.value" name="logo_url" widget="image_url" alt="Logo"/>
                            <i t-else="" class="fa fa-university fa-2x text-muted" title="Bank" role="img" aria-label="Bank"/>
                        </aside>
                        <main class="ms-2">
                            <field name="name" class="fw-bold fs-5"/>
                            <p class="text-muted small my-0 lh-sm">
                                <code t-if="record.code.value">Code: <field name="code"/></code>
                                <br t-if="record.code.value and record.bic.value"/>
                                <code t-if="record.bic.value">Swift: <field name="bic"/></code>
                            </p>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="res_bank_form_views" model="ir.ui.view">
        <field name="name">res.bank.form.views</field>
        <field name="model">res.bank</field>
        <field name="inherit_id" ref="base.view_res_bank_form"/>
        <field name="arch" type="xml">
            <field name="bic" position="after">
                <field name="code"/>
                <field name="bin"/>
                <field name="short_name"/>
            </field>
        </field>
    </record>

    <!-- Core only searches banks by name; find them by VietQR code, short name, BIC or BIN too. -->
    <record id="res_bank_view_search" model="ir.ui.view">
        <field name="name">res.bank.view.search.inherit.tangerine</field>
        <field name="model">res.bank</field>
        <field name="inherit_id" ref="base.res_bank_view_search"/>
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute name="string">Bank</attribute>
                <attribute name="filter_domain">['|', '|', '|', '|', ('name', 'ilike', self), ('short_name', 'ilike', self), ('code', 'ilike', self), ('bic', 'ilike', self), ('bin', 'ilike', self)]</attribute>
            </field>
            <field name="name" position="after">
                <field name="code"/>
                <field name="bic"/>
                <field name="bin"/>
            </field>
        </field>
    </record>

    <record id="base.action_res_bank_form" model="ir.actions.act_window">
        <field name="name">Banks</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.bank</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('res_bank_kanban_views')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('base.view_res_bank_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('base.view_res_bank_form')})]"/>
        <field name="search_view_id" ref="base.res_bank_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new bank
            </p>
        </field>
    </record>
</odoo>