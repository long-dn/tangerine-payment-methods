<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="vn_bank_view_kanban" model="ir.ui.view">
        <field name="name">vn.bank.kanban</field>
        <field name="model">vn.bank</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card" class="flex-row align-items-center">
                        <aside class="o_bank_logo">
                            <field t-if="record.logo_url.value" name="logo_url" widget="image_url" alt="Logo"/>
                            <i t-else="" class="fa fa-university fa-2x text-muted" title="Bank" role="img" aria-label="Bank"/>
                        </aside>
                        <main class="ms-2">
                            <field name="name" class="fw-bold fs-5"/>
                            <p class="text-muted small my-0 lh-sm">
                                <code t-if="record.code.value">Code: <field name="code"/></code>
                                <br t-if="record.code.value and record.bic.value"/>
                                <code t-if="record.bic.value">Swift: <field name="bic"/></code>
                            </p>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="vn_bank_view_list" model="ir.ui.view">
        <field name="name">vn.bank.list</field>
        <field name="model">vn.bank</field>
        <field name="arch" type="xml">
            <list string="Banks">
                <field name="code"/>
                <field name="short_name"/>
                <field name="name"/>
                <field name="bin"/>
                <field name="bic"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="vn_bank_view_form" model="ir.ui.view">
        <field name="name">vn.bank.form</field>
        <field name="model">vn.bank</field>
        <field name="arch" type="xml">
            <form string="Bank">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="logo_url" widget="image_url" class="oe_avatar" invisible="not logo_url" options="{'size': [0, 64]}"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Vietcombank"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="short_name"/>
                            <field name="code"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="bin"/>
                            <field name="bic"/>
                            <field name="logo_url" widget="url"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="vn_bank_view_search" model="ir.ui.view">
        <field name="name">vn.bank.search</field>
        <field name="model">vn.bank</field>
        <field name="arch" type="xml">
            <search string="Banks">
                <field name="name" string="Bank" filter_domain="['|', '|', '|', '|', ('name', 'ilike', self), ('short_name', 'ilike', self), ('code', 'ilike', self), ('bic', 'ilike', self), ('bin', 'ilike', self)]"/>
                <field name="code"/>
                <field name="bic"/>
                <field name="bin"/>
                <separator/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_vn_bank" model="ir.actions.act_window">
        <field name="name">Banks</field>
        <field name="res_model">vn.bank</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="vn_bank_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new bank
            </p>
            <p>
                Use "Sync from VietQR" in the Actions menu to load the Vietnamese banks.
            </p>
        </field>
    </record>
</odoo>
