<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Manual refresh of the bank directory, reachable from the Actions menu. -->
    <record id="action_server_bank_information_sync" model="ir.actions.server">
        <field name="name">Sync from VietQR</field>
        <field name="model_id" ref="base.model_res_bank"/>
        <field name="binding_model_id" ref="base.model_res_bank"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[Command.link(ref('base.group_partner_manager'))]"/>
        <field name="state">code</field>
        <field name="code">model.bank_information_sync()</field>
    </record>
</odoo>
