<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        The QR itself comes from payment.transaction._get_custom_qr_code().
        Cap the 540x540 SePay card; core's own 128px QR stays untouched.
    -->
    <template id="custom_payment_transfer_details" inherit_id="payment_custom.custom_payment_transfer_details">
        <xpath expr="//div[hasclass('o_qr_code_card')]//img" position="attributes">
            <attribute name="style">max-width: 200px;</attribute>
        </xpath>
    </template>
</odoo>
