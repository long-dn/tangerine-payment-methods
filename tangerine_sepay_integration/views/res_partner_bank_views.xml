<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_bank_form_inherit_tangerine_sepay" model="ir.ui.view">
        <field name="name">res.partner.bank.form.inherit.tangerine.sepay</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="base.view_partner_bank_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="journal_id" invisible="1"/>
                <group name="sepay_virtual_account" string="SePay" invisible="not journal_id">
                    <field name="sepay_va_number"
                           placeholder="e.g. QRPSEP1ZZZZ54900752"
                           required="sepay_use_va"/>
                    <field name="sepay_use_va" widget="boolean_toggle"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
