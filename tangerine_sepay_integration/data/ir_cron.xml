<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        The processing cron ships enabled: the webhook route only stores the
        raw transaction and hands the accounting work over here, so a disabled
        cron turns every accepted webhook into a record that nobody ever looks
        at. It is cheap to leave running because it only ever selects
        transactions of a company that explicitly enabled SePay.
    -->
    <record id="ir_cron_process_transactions" model="ir.cron">
        <field name="name">SePay: Process received transactions</field>
        <field name="model_id" ref="model_sepay_transaction"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_transactions()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <!--
        API polling stays off until an accountant turns it on from the SePay
        settings: it reaches a third-party service and only adds value once an
        API token is configured. Webhook-only installations never need it.
    -->
    <record id="ir_cron_sync_transactions" model="ir.cron">
        <field name="name">SePay: Synchronize API transactions</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="state">code</field>
        <field name="code">model._cron_sepay_sync_transactions()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
