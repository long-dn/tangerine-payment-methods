<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="payment_method_sepay" model="payment.method">
        <field name="name">SePay</field>
        <field name="code">sepay</field>
        <field name="sequence">1</field>
        <field name="provider_id" ref="payment.payment_provider_transfer"/>
        <field name="active" eval="True"/>
        <field name="image" type="bytes" file="tangerine_sepay_integration/static/description/icon.png"/>
        <field name="support_tokenization">False</field>
        <field name="support_express_checkout">False</field>
        <field name="support_manual_capture">none</field>
        <field name="support_refund">none</field>
        <field name="supported_country_ids" eval="[Command.set([ref('base.vn')])]"/>
        <field name="supported_currency_ids" eval="[Command.set([ref('base.VND')])]"/>
    </record>
</odoo>
